---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Clean Slate",
  description = "Professional construction cleanup, junk removal, dumpster rental, and portable storage throughout Central Iowa.",
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>{title}</title>
    <meta name="description" content={description} />

    <slot name="head" />
  </head>

  <body>
    <slot />
  </body>
</html>