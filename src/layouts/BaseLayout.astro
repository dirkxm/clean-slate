---
import "../styles/global.css";
import { site } from "../config/site";
import { locationNames } from "../data/locations";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Clean Slate",
  description = "Professional construction cleanup, junk removal, and portable storage throughout Central Iowa.",
} = Astro.props;

// Self-referencing canonical URL. Always built from the site.ts domain
// plus this page's own path, so it can never drift from the sitemap.
// Trailing slash matches Astro's directory build output and @astrojs/sitemap.
const canonicalPath = Astro.url.pathname.endsWith("/")
  ? Astro.url.pathname
  : `${Astro.url.pathname}/`;
const canonicalURL = new URL(canonicalPath, site.url);

// Absolute URL for the social-share image (Open Graph / Twitter require
// a fully-qualified URL). Built from the same site.ts domain as the
// canonical tag so it can never drift.
const ogImageURL = new URL(site.ogImage, site.url);

// Site-wide LocalBusiness schema. Service-area business: no street
// address, coverage expressed via areaServed (pulled from the same
// src/data/locations.ts as every on-page "areas served" list).
const localBusinessSchema = {
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  "@id": new URL("#business", site.url).href,
  name: site.name,
  legalName: site.legalName,
  description: site.description,
  url: site.url,
  telephone: `+1${site.phoneRaw}`,
  email: site.email,
  address: {
    "@type": "PostalAddress",
    addressLocality: site.address.city,
    addressRegion: site.address.state,
    addressCountry: site.address.country,
  },
  areaServed: locationNames.map((name) => ({ "@type": "City", name })),
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />

    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify(localBusinessSchema)}
    />

    <slot name="head" />
  </head>

  <body>
    <slot />
  </body>
</html>