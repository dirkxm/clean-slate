---
import "../styles/global.css";
import { site } from "../config/site";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Clean Slate",
  description = "Professional construction cleanup, junk removal, and portable storage throughout Central Iowa.",
} = Astro.props;

// Self-referencing canonical URL. Always built from the site.ts domain
// plus this page's own path, so it can never drift from the sitemap.
// Trailing slash matches Astro's directory build output and @astrojs/sitemap.
const canonicalPath = Astro.url.pathname.endsWith("/")
  ? Astro.url.pathname
  : `${Astro.url.pathname}/`;
const canonicalURL = new URL(canonicalPath, site.url);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <slot name="head" />
  </head>

  <body>
    <slot />
  </body>
</html>