---
import "../styles/global.css";
import { site } from "../config/site";
import { locationNames } from "../data/locations";

interface Props {
  title?: string;
  description?: string;
  // Overrides the text used for og:description / twitter:description.
  // Defaults to `description` (the same text as the meta description).
  ogDescription?: string;
}

const {
  title = "Clean Slate Services",
  description = "Professional construction cleanup, junk removal, and portable storage throughout Central Iowa.",
  ogDescription = description,
} = Astro.props;

// Self-referencing canonical URL. Always built from the site.ts domain
// plus this page's own path, so it can never drift from the sitemap.
// Trailing slash matches Astro's directory build output and @astrojs/sitemap.
const canonicalPath = Astro.url.pathname.endsWith("/")
  ? Astro.url.pathname
  : `${Astro.url.pathname}/`;
const canonicalURL = new URL(canonicalPath, site.url);

// Absolute URL for the social-share image (Open Graph / Twitter require
// a fully-qualified URL). Built from the same site.ts domain as the
// canonical tag so it can never drift.
const ogImageURL = new URL(site.ogImage, site.url);

// Site-wide LocalBusiness schema. Service-area business: no street
// address, coverage expressed via areaServed (pulled from the same
// src/data/locations.ts as every on-page "areas served" list).
const localBusinessSchema = {
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  "@id": new URL("#business", site.url).href,
  name: site.name,
  legalName: site.legalName,
  description: site.description,
  url: site.url,
  telephone: `+1${site.phoneRaw}`,
  email: site.email,
  address: {
    "@type": "PostalAddress",
    addressLocality: site.address.city,
    addressRegion: site.address.state,
    addressCountry: site.address.country,
  },
  areaServed: locationNames.map((name) => ({ "@type": "City", name })),
  // Mon-Fri 8am-6pm, Sat 8am-noon, closed Sunday. Sunday is omitted
  // rather than listed as closed — that's the schema.org convention.
  openingHours: ["Mo-Fr 08:00-18:00", "Sa 08:00-12:00"],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={ogDescription} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={ogDescription} />
    <meta name="twitter:image" content={ogImageURL} />

    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify(localBusinessSchema)}
    />

    <!-- GA4. Loaded on the main thread, not via Partytown — gtag() calls
         made through the Partytown proxy never reached GA4 in practice.
         is:inline on the config script so Astro doesn't bundle it as a
         deferred module; it needs to define window.gtag before anything
         else (the phone_click/cta_click listeners below) runs. -->
    <script async src={`https://www.googletagmanager.com/gtag/js?id=${site.gaMeasurementId}`}></script>
    <script
      is:inline
      set:html={`window.dataLayer = window.dataLayer || [];
        function gtag(){ dataLayer.push(arguments); }
        gtag('js', new Date());
        gtag('config', '${site.gaMeasurementId}');`}
    />

    <slot name="head" />
  </head>

  <body>
    <slot />

    <!-- GA4 event tracking: phone_click for every tel: link, cta_click for
         every link/button into a Jobber booking form or the Free Quote
         form (flagged with data-cta — see Button.astro, CTA.astro, and
         the individual pages/components that set it). gtag() is already
         defined on window by the config script in <head>. -->
    <script is:inline>
      document.querySelectorAll('a[href^="tel:"]').forEach((a) => {
        a.addEventListener('click', () => {
          gtag('event', 'phone_click', {
            link_url: a.getAttribute('href'),
            page_path: location.pathname,
          });
        });
      });
    </script>

    <script is:inline>
      document.addEventListener('click', (event) => {
        const cta = event.target.closest('[data-cta]');
        if (!cta) return;
        gtag('event', 'cta_click', {
          cta_label: cta.dataset.cta,
          page_path: location.pathname,
        });
      });
    </script>
  </body>
</html>