---
import { ChevronDown } from "lucide-astro";
import SectionHeading from "../ui/SectionHeading.astro";

interface FaqItem {
  question: string;
  answer: string;
}

interface Props {
  title?: string;
  faqs: FaqItem[];
  closingNote?: string;
}

const {
  title = "Questions? We've Got Answers.",
  faqs,
  closingNote,
} = Astro.props;
---

<section>
  <div class="container">

    <SectionHeading title={title} />

    <div class="mx-auto mt-16 max-w-3xl divide-y divide-border">
      {
        faqs.map((faq) => (
          <details class="group py-6">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-semibold text-heading">
              {faq.question}

              <ChevronDown
                class="shrink-0 transition duration-300 group-open:rotate-180"
                size={20}
              />
            </summary>

            <p class="mt-4 text-body">{faq.answer}</p>
          </details>
        ))
      }
    </div>

    {closingNote && (
      <p class="mx-auto mt-10 max-w-3xl text-center font-medium text-heading">
        {closingNote}
      </p>
    )}

  </div>
</section>
