---
import { Image } from "astro:assets";
import defaultImage from "../../assets/images/kitchen-cleanup.jpg";
import type { ImageMetadata } from "astro";

interface Props {
  title?: string;
  paragraphs?: string[];
  highlight?: string;
  image?: ImageMetadata;
  imageAlt?: string;
}

const {
  title = "Get Your Price & Book Online in Minutes",
  paragraphs = [
    "Tell us what you need removed, provide the details online, and get an accurate price before you book. Choose a convenient time and you're done—no waiting for estimates or playing phone tag.",
    "We work hard to make the price you see online the price you can expect. If the job is smaller than described, we'll refund the difference. If it's larger, we'll communicate with you and adjust the price accordingly.",
  ],
  highlight = "Simple booking. Accurate pricing. No surprises.",
  image = defaultImage,
  imageAlt = "Kitchen cleanup",
} = Astro.props;
---

<section>
  <div class="container grid gap-16 lg:grid-cols-2 lg:items-center">

    <div class="aspect-[4/3] overflow-hidden rounded-3xl lg:order-2">
      <Image
        src={image}
        alt={imageAlt}
        class="h-full w-full object-cover"
        widths={[480, 800, 1200]}
        sizes="(min-width: 1024px) 50vw, 100vw"
        format="webp"
        quality={80}
      />
    </div>

    <div class="lg:order-1">

      <h2 class="mb-6">
        {title}
      </h2>

      {
        paragraphs.map((paragraph) => (
          <p class="mb-4! max-w-xl text-body">{paragraph}</p>
        ))
      }

      {highlight && (
        <p class="mt-6 max-w-xl text-xl font-semibold text-heading">
          {highlight}
        </p>
      )}

    </div>

  </div>
</section>
