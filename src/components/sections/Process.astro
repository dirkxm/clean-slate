---
import SectionHeading from "../ui/SectionHeading.astro";

const steps = [
  { number: "01", title: "Request a Quote" },
  { number: "02", title: "Schedule Delivery or Cleanup" },
  { number: "03", title: "We Handle the Work" },
  { number: "04", title: "Project Complete" },
];
---

<section>
  <div class="container">

    <SectionHeading title="Process" />

    <div class="mt-20 grid divide-y divide-border lg:grid-cols-4 lg:divide-x lg:divide-y-0">
      {
        steps.map((step) => (
          <div class="flex flex-col gap-6 px-4 py-12 first:pt-0 last:pb-0 lg:px-10 lg:py-0">
            <span class="font-display text-7xl font-medium text-primary/20">
              {step.number}
            </span>

            <h3 class="text-2xl">
              {step.title}
            </h3>
          </div>
        ))
      }
    </div>

  </div>
</section>
