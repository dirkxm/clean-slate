---
import SectionHeading from "../ui/SectionHeading.astro";
import ServiceCard from "../cards/ServiceCard.astro";
import { services } from "../../data/services";
---

<section class="bg-primary-dark">
  <div class="container">

    <SectionHeading
      title="Services"
      theme="dark"
    />

    <div class="mt-16 grid gap-8 md:grid-cols-2">
      {
        services.map((service) => (
          <ServiceCard
            service={service}
            icon={service.icon}
            image={service.image}
            href={service.href}
            layout="horizontal"
          />
        ))
      }
    </div>

  </div>
</section>
