---
import { Image } from "astro:assets";
import Button from "../ui/Button.astro";
import defaultHeroImage from "../../assets/images/clean-slate-haul-away.jpg";
import type { ImageMetadata } from "astro";
import { ArrowRight, Check, Star } from "lucide-astro";

const trustBadges = [
  "Book Online 24/7",
  "Real Person — Call or Text",
  "Fast Scheduling",
  "Licensed & Insured",
];

interface Props {
  eyebrow?: string;
  title: string;
  description: string;
  image?: ImageMetadata;
  imageAlt?: string;
  showTrustBadges?: boolean;
  showImage?: boolean;
  buttonLabel?: string;
  showViewPricing?: boolean;
  helpText?: string;
}

const {
  eyebrow,
  title,
  description,
  image = defaultHeroImage,
  imageAlt = "Construction cleanup",
  showTrustBadges = true,
  showImage = true,
  buttonLabel = "Book Online",
  showViewPricing = true,
  helpText,
} = Astro.props;
---

<section>
  {eyebrow && (
    <div class="container">
      <p class="mt-8! mb-10! font-semibold text-primary">
        {eyebrow}
      </p>
    </div>
  )}

  <div class={showImage ? "container grid gap-16 lg:grid-cols-[1fr_2fr] lg:items-start" : "container"}>

    <div>

      <h1 class="mb-6" set:html={title} />

      <p class={showImage ? "max-w-xl text-body" : "max-w-2xl text-body"}>
        {description}
      </p>

      <div class="mt-10 flex flex-wrap items-center gap-6">
        <Button href="/book-online" size="sm">
          {buttonLabel}
        </Button>

        {showViewPricing && (
          <a
            href="/pricing"
            class="group inline-flex items-center gap-2 font-medium text-primary transition hover:text-primary-dark"
          >
            View Pricing

            <ArrowRight
              class="transition group-hover:translate-x-1"
              size={18}
            />
          </a>
        )}
      </div>

      {helpText ? (
        <p class="mt-10 max-w-xl text-body">
          {helpText}
        </p>
      ) : showTrustBadges && (
        <>
          <p class="mt-10 mb-3! font-semibold text-heading">
            Need help first? Call or text us.
          </p>

          <ul class="flex flex-wrap items-center gap-x-6 gap-y-3">
            {
              trustBadges.map((badge) => (
                <li class="flex items-center gap-2 text-sm text-body">
                  <Check class="shrink-0 text-primary" size={16} />
                  {badge}
                </li>
              ))
            }

            <li class="flex items-center gap-2 text-sm text-body">
              <span class="flex gap-0.5 text-primary">
                {Array.from({ length: 5 }).map(() => (
                  <Star size={14} fill="currentColor" stroke="none" />
                ))}
              </span>
              5-Star Local Service
            </li>
          </ul>
        </>
      )}

    </div>

    {showImage && (
      <div class="rounded-3xl overflow-hidden">
        <Image
          src={image}
          alt={imageAlt}
          class="w-full object-cover"
          widths={[480, 800, 1200, 1400]}
          sizes="(min-width: 1024px) 66vw, 100vw"
          format="webp"
          quality={80}
        />
      </div>
    )}

  </div>
</section>