---
import Button from "../ui/Button.astro";
import heroImage from "../../assets/images/clean-slate-haul-away.jpg";
import { site } from "../../config/site";
import { ArrowRight } from "lucide-astro";

interface Props {
  eyebrow?: string;
  title: string;
  description: string;
}

const { eyebrow, title, description } = Astro.props;
---

<section>
  {eyebrow && (
    <div class="container">
      <p class="mt-8! mb-10! font-semibold text-primary">
        {site.tagline}
      </p>
    </div>
  )}

  <div class="container grid gap-16 lg:grid-cols-[1fr_2fr] lg:items-start">

    <div>

      <h1 class="mb-6" set:html={title} />

      <p class="max-w-xl text-body">
        {description}
      </p>

      <div class="mt-10 flex flex-wrap items-center gap-6">
        <Button href="/contact" size="sm">
          Get a Free Quote
        </Button>

        <a
          href="/pricing"
          class="group inline-flex items-center gap-2 font-medium text-primary transition hover:text-primary-dark"
        >
          View Pricing

          <ArrowRight
            class="transition group-hover:translate-x-1"
            size={18}
          />
        </a>
      </div>

      ✓ Same-Day Service

✓ Licensed & Insured

✓ Free Estimates

★★★★★ 5-Star Local Service

    </div>

    <div class="rounded-3xl overflow-hidden">
      <img
        src={heroImage.src}
        alt="Construction cleanup"
        class="w-full object-cover"
      />
    </div>

  </div>
</section>