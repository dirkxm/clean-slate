---
import { HardHat, Trash2, Package, Truck, Home, Warehouse, Building2 } from "lucide-astro";
import ServiceCard from "../cards/ServiceCard.astro";
import { services } from "../../data/services";
import constructionCleanupImage from "../../assets/images/construction-cleanup.jpg";
import dumpsterRentalImage from "../../assets/images/dumpster-rental-2.jpg";
import portableStorageImage from "../../assets/images/temporary-storage.jpg";
import junkRemovalImage from "../../assets/images/furniture-haul-away.jpg";
import estateCleanoutImage from "../../assets/images/estate-cleanout.jpg";
import garageCleanoutImage from "../../assets/images/garage-cleanout.jpg";
import propertyCleanoutImage from "../../assets/images/property-cleanout.jpg";
import type { ImageMetadata } from "astro";

const icons: Record<string, typeof HardHat> = {
  "construction-cleanup": HardHat,
  "junk-removal": Truck,
  "dumpster-rental": Trash2,
  "portable-storage": Package,
  "estate-cleanouts": Home,
  "garage-cleanouts": Warehouse,
  "property-cleanouts": Building2,
};

const images: Record<string, ImageMetadata> = {
  "construction-cleanup": constructionCleanupImage,
  "junk-removal": junkRemovalImage,
  "dumpster-rental": dumpsterRentalImage,
  "portable-storage": portableStorageImage,
  "estate-cleanouts": estateCleanoutImage,
  "garage-cleanouts": garageCleanoutImage,
  "property-cleanouts": propertyCleanoutImage,
};
---

<section class="bg-primary-dark">
  <div class="container">

    <div class="flex flex-wrap justify-center gap-8">
      {
        services.map((service) => (
          <div class="flex w-full md:w-[calc(50%-1rem)] lg:w-[calc(25%-1.5rem)]">
            <ServiceCard
              service={service}
              icon={icons[service.slug]}
              image={images[service.slug]}
            />
          </div>
        ))
      }
    </div>

  </div>
</section>
