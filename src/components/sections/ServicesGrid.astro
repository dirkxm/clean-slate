---
import ServiceCard from "../cards/ServiceCard.astro";
import { services } from "../../data/services";
import type { ServiceCategory } from "../../data/services";

// Group the service cards under category subheadings, in the same order
// used on /online-ordering.
const categoryOrder: ServiceCategory[] = [
  "Cleanouts",
  "Construction",
  "Junk Removal",
  "Portable Storage",
];

const groups = categoryOrder
  .map((category) => ({
    category,
    items: services.filter((service) => service.category === category),
  }))
  .filter((group) => group.items.length > 0);
---

<section class="bg-primary-dark">
  <div class="container">

    <div class="flex flex-col gap-16">
      {
        groups.map((group) => (
          <div>
            <p class="mb-6 text-sm font-semibold uppercase tracking-[0.25em] text-accent">
              {group.category}
            </p>

            <div class="flex flex-wrap gap-8">
              {group.items.map((service) => (
                <div class="flex w-full md:w-[calc(50%-1rem)] lg:w-[calc(25%-1.5rem)]">
                  <ServiceCard
                    service={service}
                    icon={service.icon}
                    image={service.image}
                    href={service.href}
                  />
                </div>
              ))}
            </div>
          </div>
        ))
      }
    </div>

  </div>
</section>
