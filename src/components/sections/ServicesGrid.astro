---
import ServiceCard from "../cards/ServiceCard.astro";
import { services } from "../../data/services";
---

<section class="bg-primary-dark">
  <div class="container">

    <div class="flex flex-wrap justify-center gap-8">
      {
        services.map((service) => (
          <div class="flex w-full md:w-[calc(50%-1rem)] lg:w-[calc(25%-1.5rem)]">
            <ServiceCard
              service={service}
              icon={service.icon}
              image={service.image}
              href={service.href}
            />
          </div>
        ))
      }
    </div>

  </div>
</section>
