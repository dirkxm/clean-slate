---
import Button from "../ui/Button.astro";

interface Props {
  title?: string;
  description?: string;
  buttonLabel?: string;
  buttonHref?: string;
  secondaryLabel?: string;
  secondaryHref?: string;
}

const {
  title = "Ready to get it cleaned up?",
  description = "Choose your service, pick a time, and book online. Need help deciding? Text or call and talk to a real person.",
  buttonLabel = "Get Your Price & Book Online",
  buttonHref = "/online-ordering",
  secondaryLabel,
  secondaryHref,
} = Astro.props;
---

<section class="bg-primary-dark">
  <div class="container text-center">

    <h2 class="mb-4 text-4xl! text-white!">
      {title}
    </h2>

    <p class="mb-10 text-xl text-white/70">
      {description}
    </p>

    <div class="flex flex-col items-center gap-4">
      <Button href={buttonHref} variant="secondary">
        {buttonLabel}
      </Button>

      {secondaryLabel && secondaryHref ? (
        <a
          href={secondaryHref}
          class="font-medium text-white/70 transition hover:text-white"
        >
          {secondaryLabel}
        </a>
      ) : (
        <a
          href="tel:+15155199878"
          class="font-medium text-white/70 transition hover:text-white"
        >
          Text or Call (515) 519-9878
        </a>
      )}
    </div>

  </div>
</section>
