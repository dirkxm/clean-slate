---
import { ArrowRight } from "lucide-astro";
import type { ComponentProps } from "astro/types";

interface Props {
  service: {
    title: string;
    slug: string;
    short: string;
  };
  icon: (props: ComponentProps<typeof ArrowRight>) => any;
}

const { service, icon: Icon } = Astro.props;
---

<a
  href={`/${service.slug}`}
  class="group block overflow-hidden rounded-3xl border border-border bg-white shadow-soft transition duration-300 hover:-translate-y-2 hover:border-primary"
>

  <div class="flex aspect-[4/3] items-center justify-center bg-gradient-to-br from-primary/10 to-primary/5">
    <Icon class="text-primary/40" size={56} strokeWidth={1.5} />
  </div>

  <div class="border-t border-border p-8">

    <h3 class="mb-4">
      {service.title}
    </h3>

    <p class="mb-8 text-body">
      {service.short}
    </p>

    <span
      class="inline-flex items-center gap-2 font-semibold text-primary"
    >
      Learn More

      <ArrowRight
        class="transition group-hover:translate-x-1"
        size={18}
      />

    </span>

  </div>

</a>
