---
import { ArrowRight } from "lucide-astro";
import { Image } from "astro:assets";
import type { ComponentProps } from "astro/types";
import type { ImageMetadata } from "astro";

interface Props {
  service: {
    title: string;
    slug: string;
    short: string;
    hook?: string;
  };
  icon: (props: ComponentProps<typeof ArrowRight>) => any;
  image?: ImageMetadata;
  href?: string;
  layout?: "vertical" | "horizontal";
}

const { service, icon: Icon, image, href, layout = "vertical" } = Astro.props;
const isHorizontal = layout === "horizontal";
---

<a
  href={href ?? `/services/${service.slug}`}
  class={`group flex h-full overflow-hidden rounded-3xl border border-border bg-white shadow-soft transition duration-300 hover:-translate-y-2 hover:border-primary ${isHorizontal ? "flex-col sm:flex-row" : "flex-col"}`}
>

  <div class={`shrink-0 overflow-hidden bg-gradient-to-br from-primary/10 to-primary/5 ${isHorizontal ? "aspect-[4/3] sm:aspect-auto sm:w-2/5" : "aspect-[4/3]"}`}>
    {image ? (
      <Image
        src={image}
        alt={service.title}
        class="h-full w-full object-cover"
        widths={[320, 480, 640]}
        sizes={isHorizontal ? "(min-width: 640px) 40vw, 100vw" : "(min-width: 1024px) 33vw, 100vw"}
        format="webp"
        quality={80}
      />
    ) : (
      <div class="flex h-full items-center justify-center">
        <Icon class="text-primary/40" size={56} strokeWidth={1.5} />
      </div>
    )}
  </div>

  <div class={`flex flex-1 flex-col justify-center p-6 border-border ${isHorizontal ? "border-t sm:border-t-0 sm:border-l" : "border-t"}`}>

    <h3 class="mb-2">
      {service.title}
    </h3>

    {service.hook && (
      <p class="mb-2! font-semibold text-heading">
        {service.hook}
      </p>
    )}

    <p class="mb-4 flex-1 text-body">
      {service.short}
    </p>

    <span
      class="inline-flex items-center gap-2 font-semibold text-primary"
    >
      Learn More

      <ArrowRight
        class="transition group-hover:translate-x-1"
        size={18}
      />

    </span>

  </div>

</a>
