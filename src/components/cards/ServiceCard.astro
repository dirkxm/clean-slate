---
import { ArrowRight } from "lucide-astro";

interface Props {
  service: {
    title: string;
    slug: string;
    short: string;
  };
}

const { service } = Astro.props;
---

<a
  href={`/${service.slug}`}
  class="group block rounded-3xl border border-border bg-white p-8 shadow-soft transition duration-300 hover:-translate-y-2 hover:border-primary"
>

  <h3 class="mb-4">
    {service.title}
  </h3>

  <p class="mb-8 text-body">
    {service.short}
  </p>

  <span
    class="inline-flex items-center gap-2 font-semibold text-primary"
  >
    Learn More

    <ArrowRight
      class="transition group-hover:translate-x-1"
      size={18}
    />

  </span>

</a>