---
interface Props {
  eyebrow?: string;
  title: string;
  description?: string;
  align?: "left" | "center";
  theme?: "light" | "dark";
}

const {
  eyebrow,
  title,
  description,
  align = "center",
  theme = "light",
} = Astro.props;

const alignment =
  align === "center"
    ? "mx-auto text-center"
    : "";
---

<div class={`max-w-3xl ${alignment} ${theme === "dark" ? "theme-dark" : ""}`}>

  {eyebrow && (
    <p class="mb-3 text-sm font-semibold uppercase tracking-[0.25em] text-primary">
      {eyebrow}
    </p>
  )}

  <h2 class="mb-6">
    {title}
  </h2>

  {description && (
    <p class="text-lg text-body">
      {description}
    </p>
  )}

</div>

<style>
  .theme-dark h2 {
    color: #fff;
  }

  .theme-dark p.text-body {
    color: rgb(255 255 255 / 0.8);
  }

  .theme-dark p.text-primary {
    color: var(--color-accent);
  }
</style>