---
interface Props {
  eyebrow?: string;
  title: string;
  description?: string;
  align?: "left" | "center";
}

const {
  eyebrow,
  title,
  description,
  align = "center",
} = Astro.props;

const alignment =
  align === "center"
    ? "mx-auto text-center"
    : "";
---

<div class={`max-w-3xl ${alignment}`}>

  {eyebrow && (
    <p class="mb-3 text-sm font-semibold uppercase tracking-[0.25em] text-primary">
      {eyebrow}
    </p>
  )}

  <h2 class="mb-6">
    {title}
  </h2>

  {description && (
    <p class="text-lg text-body">
      {description}
    </p>
  )}

</div>