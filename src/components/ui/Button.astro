---
interface Props {
  href?: string;
  variant?: "primary" | "secondary" | "text";
  size?: "default" | "sm";
  disabled?: boolean;
  loading?: boolean;
  // Passed through to the rendered element — e.g. data-cta for the
  // delegated cta_click tracking listener in BaseLayout.astro.
  [dataAttr: `data-${string}`]: string | undefined;
}

const {
  href = "#",
  variant = "primary",
  size = "default",
  disabled = false,
  loading = false,
  ...rest
} = Astro.props;

const sizes = {
  default: "px-6 py-3 text-[17px]",
  sm: "px-4 py-2 text-[16px]",
};

const variants = {
  primary: "bg-primary text-white hover:bg-primary-dark",
  secondary: "border border-border bg-white text-heading hover:bg-gray-50",
  text: "text-primary hover:text-primary-dark",
};

const isDisabled = disabled || loading;

const classes = `inline-flex items-center justify-center gap-2 rounded-xl font-medium transition ${sizes[size]} ${variants[variant]} ${isDisabled ? "pointer-events-none opacity-50" : ""}`;
---

{
  isDisabled ? (
    <button type="button" class={classes} disabled aria-busy={loading} {...rest}>
      {loading && (
        <span
          class="h-4 w-4 shrink-0 animate-spin rounded-full border-2 border-current border-t-transparent"
          aria-hidden="true"
        />
      )}
      <slot />
    </button>
  ) : (
    <a href={href} class={classes} {...rest}>
      <slot />
    </a>
  )
}
