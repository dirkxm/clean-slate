---
interface Props {
  href?: string;
  variant?: "primary" | "secondary";
  size?: "default" | "sm";
}

const {
  href = "#",
  variant = "primary",
  size = "default",
} = Astro.props;

const sizes = {
  default: "px-6 py-3 text-[17px]",
  sm: "px-4 py-2 text-[16px]",
};

const classes = {
  primary:
    `inline-flex items-center justify-center rounded-xl bg-primary text-white font-medium transition hover:bg-primary-dark ${sizes[size]}`,

  secondary:
    `inline-flex items-center justify-center rounded-xl border border-border bg-white text-heading font-medium transition hover:bg-gray-50 ${sizes[size]}`,
};
---

<a href={href} class={classes[variant]}>
  <slot />
</a>