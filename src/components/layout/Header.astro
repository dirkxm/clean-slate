---
import { site } from "../../config/site";
import Button from "../ui/Button.astro";
import "../../styles/components/header.css";

const navigation = [
  {
    label: "Services",
    href: "/services",
    children: [
      { label: "Construction Cleanup", href: "/construction-cleanup" },
      { label: "Junk Removal", href: "/junk-removal" },
      { label: "Dumpster Rental", href: "/dumpster-rental" },
      { label: "Portable Storage", href: "/portable-storage" },
      { label: "Estate Cleanouts", href: "/estate-cleanouts" },
      { label: "Garage Cleanouts", href: "/garage-cleanouts" },
      { label: "Property Cleanouts", href: "/property-cleanouts" }
    ]
  },
  {
    label: "Locations",
    href: "/locations"
  },
  {
    label: "Gallery",
    href: "/gallery"
  },
  {
    label: "Pricing",
    href: "/pricing"
  },
  {
    label: "About",
    href: "/about"
  }
];
---

<header id="site-header">
  <div class="container">
    <a href="/" class="logo">
      <span class="brand">Clean Slate</span>
    </a>

    <nav class="desktop-nav">
      {
        navigation.map((item) => (
          <a href={item.href}>
            {item.label}
            {item.children && (
              <svg
                width="16"
                height="16"
                viewBox="0 0 20 20"
                fill="none"
              >
                <path
                  d="M5 7l5 5 5-5"
                  stroke="currentColor"
                  stroke-width="1.8"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                />
              </svg>
            )}
          </a>
        ))
      }
    </nav>

    <div class="actions">
      <a class="phone" href="tel:+15152023593">
        (515) 202-3593
      </a>

      <Button href="/contact">
        Start My Project
      </Button>
    </div>

    <button
      id="mobile-toggle"
      class="mobile-toggle"
      aria-label="Open navigation"
    >
      ☰
    </button>
  </div>
</header>

<script>
const header=document.getElementById("site-header");

window.addEventListener("scroll",()=>{

if(window.scrollY>25){

header?.classList.add("scrolled");

}else{

header?.classList.remove("scrolled");

}

});
</script>