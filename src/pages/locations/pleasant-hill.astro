---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/layout/Header.astro";
import Footer from "../../components/layout/Footer.astro";
import Button from "../../components/ui/Button.astro";
import CTA from "../../components/sections/CTA.astro";
import { Check, Sofa, Warehouse, Building2, Home, HardHat, Truck, ArrowRight } from "lucide-astro";

const services = [
  {
    icon: Warehouse,
    title: "Garage Cleanouts",
    description: "Clear out years of accumulated stuff and take your garage back.",
    href: "/services/garage-cleanouts",
  },
  {
    icon: Building2,
    title: "Property Cleanouts",
    description: "Full property cleanouts for homes, rentals, and more.",
    href: "/services/property-cleanouts",
  },
  {
    icon: Home,
    title: "Estate Cleanouts",
    description: "A respectful, straightforward way to clear a home.",
    href: "/services/estate-cleanouts",
  },
  {
    icon: HardHat,
    title: "Construction Cleanup",
    description: "Keep your remodeling or construction project moving.",
    href: "/services/construction-cleanup",
  },
  {
    icon: Sofa,
    title: "Furniture & Appliance Removal",
    description: "Couches, mattresses, and other bulky items hauled away.",
    href: "/services/furniture-removal",
  },
  {
    icon: Truck,
    title: "Junk Removal",
    description: "General junk and unwanted items removed quickly.",
    href: "/services/junk-removal",
  },
];

const furnitureItems = [
  "Couches & sofas",
  "Sectionals",
  "Recliners & chairs",
  "Tables & desks",
  "Dressers & cabinets",
  "Bed frames",
  "Mattresses & box springs",
  "Entertainment centers",
  "Patio furniture",
];

const largeItems = [
  "Refrigerators",
  "Freezers",
  "Washers & dryers",
  "Exercise equipment",
  "Other unwanted household items",
];

const debrisItems = [
  "Garage and basement contents",
  "Boxes and miscellaneous items",
  "Yard and outdoor debris",
  "General unwanted items",
];
---

<BaseLayout
  title="Junk Removal & Cleanout Services in Pleasant Hill, IA | Clean Slate"
  description="Clean Slate provides junk removal, furniture removal, and cleanout services in Pleasant Hill, IA, one of the fastest-growing communities in the Des Moines metro."
>

  <Header />

  <main>

    <!-- ================= Hero ================= -->
    <section>
      <div class="container">

        <h1 class="mt-12 mb-6 max-w-3xl">
          Junk Removal &amp; Cleanout Services in Pleasant Hill, IA
        </h1>

        <p class="mb-4! max-w-xl text-xl font-semibold text-heading">
          Suburban and rural — either way, we'll get it out.
        </p>

        <p class="max-w-2xl text-lg text-body">
          Pleasant Hill blends suburban neighborhoods with more rural,
          acreage-style properties just east of Des Moines, and it's one
          of the fastest-growing communities in the metro.
        </p>

        <p class="mt-6 max-w-2xl text-lg text-body">
          From garage cleanouts to full property clearing, Clean Slate
          handles the heavy lifting.
        </p>

        <div class="mt-10 flex flex-wrap items-center gap-4">
          <Button href="/online-ordering" size="sm">Book Online</Button>

          <a
            href="tel:+15152023593"
            class="inline-flex items-center gap-2 font-medium text-primary transition hover:text-primary-dark"
          >
            Text or Call (515) 202-3593
          </a>
        </div>

      </div>
    </section>

    <!-- ================= Services ================= -->
    <section class="border-t border-border">
      <div class="container">

        <h2 class="mb-4 max-w-3xl">
          Junk Removal &amp; Cleanout Services in Pleasant Hill
        </h2>

        <p class="max-w-2xl text-lg text-body">
          Clean Slate provides full-service removal and cleanout services
          throughout Pleasant Hill, from newer neighborhoods to larger
          acreage properties near the edge of town.
        </p>

        <div class="mt-12 grid gap-10 sm:grid-cols-2 lg:grid-cols-3">
          {
            services.map((service) => (
              <a href={service.href} class="group flex flex-col">
                <service.icon
                  class="mb-4 text-primary"
                  size={32}
                  strokeWidth={1.5}
                />

                <h3 class="mb-2 text-xl! group-hover:text-primary!">
                  {service.title}
                </h3>

                <p class="mb-3 text-body">{service.description}</p>

                <span class="inline-flex items-center gap-2 font-semibold text-primary">
                  Learn More
                  <ArrowRight
                    class="transition group-hover:translate-x-1"
                    size={16}
                  />
                </span>
              </a>
            ))
          }
        </div>

      </div>
    </section>

    <!-- ================= No Truck. No Trailer. ================= -->
    <section class="border-t border-border py-16! text-center">
      <div class="container">

        <h2 class="mb-8">No Truck. No Trailer. No Dump Run.</h2>

        <p class="mx-auto max-w-2xl text-lg text-body">
          Between suburban lots and larger acreage properties, Pleasant
          Hill jobs range from a single garage cleanout to clearing an
          entire property — we handle the lifting, loading, and hauling
          either way.
        </p>

        <p class="mx-auto mt-6 max-w-2xl text-2xl font-semibold text-heading">
          Clean Slate handles the lifting, loading, hauling, and removal.
        </p>

      </div>
    </section>

    <!-- ================= What We Remove ================= -->
    <section class="bg-primary-dark">
      <div class="container">

        <h2 class="mb-12 text-white!">What We Remove</h2>

        <div class="grid gap-12 sm:grid-cols-2 lg:grid-cols-3">
          <div>
            <h3 class="mb-6 text-white!">Furniture</h3>
            <ul class="flex flex-col gap-4">
              {
                furnitureItems.map((item) => (
                  <li class="flex items-center gap-3">
                    <Check class="shrink-0 text-accent" size={20} />
                    <span class="font-medium text-white">{item}</span>
                  </li>
                ))
              }
            </ul>
          </div>

          <div>
            <h3 class="mb-6 text-white!">Large Household Items</h3>
            <ul class="flex flex-col gap-4">
              {
                largeItems.map((item) => (
                  <li class="flex items-center gap-3">
                    <Check class="shrink-0 text-accent" size={20} />
                    <span class="font-medium text-white">{item}</span>
                  </li>
                ))
              }
            </ul>
          </div>

          <div>
            <h3 class="mb-6 text-white!">Property, Acreage &amp; Yard Debris</h3>
            <ul class="flex flex-col gap-4">
              {
                debrisItems.map((item) => (
                  <li class="flex items-center gap-3">
                    <Check class="shrink-0 text-accent" size={20} />
                    <span class="font-medium text-white">{item}</span>
                  </li>
                ))
              }
            </ul>
          </div>
        </div>

        <p class="mt-10 text-white/70">Not sure if we can take it? Just ask.</p>

      </div>
    </section>

    <!-- ================= Local ================= -->
    <section class="border-t border-border">
      <div class="container">

        <h2 class="mb-6 max-w-3xl">
          Serving Pleasant Hill &amp; Surrounding Areas
        </h2>

        <p class="max-w-2xl text-lg text-body">
          Clean Slate serves homeowners, landlords, and property owners
          throughout Pleasant Hill — from neighborhoods in the Southeast
          Polk School District to acreage properties on the edge of town
          — along with the surrounding Des Moines metro.
        </p>

      </div>
    </section>

    <CTA
      title="Ready to Clear the Space?"
      description="Book online and let Clean Slate take care of the heavy lifting."
    />

  </main>

  <Footer />

</BaseLayout>
