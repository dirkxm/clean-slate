---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/layout/Header.astro";
import Button from "../../components/ui/Button.astro";
import CTA from "../../components/sections/CTA.astro";
import { Check, Sofa, Warehouse, Building2, Home, HardHat, Truck, ArrowRight } from "lucide-astro";

const services = [
  {
    icon: Sofa,
    title: "Furniture Removal",
    description: "Get rid of old couches, mattresses, tables, dressers, appliances, and other bulky items.",
    href: "/services/furniture-removal",
  },
  {
    icon: Warehouse,
    title: "Garage Cleanouts",
    description: "Take back your garage by clearing out unwanted furniture, boxes, tools, equipment, and accumulated clutter.",
    href: "/services/garage-cleanouts",
  },
  {
    icon: Building2,
    title: "Property Cleanouts",
    description: "Clear homes, basements, garages, rental properties, and other spaces from unwanted belongings and debris.",
    href: "/services/property-cleanouts",
  },
  {
    icon: Home,
    title: "Estate Cleanouts",
    description: "We handle the physical work of clearing furniture, household belongings, and other items from an estate.",
    href: "/services/estate-cleanouts",
  },
  {
    icon: HardHat,
    title: "Construction Cleanup",
    description: "Keep remodeling and construction projects moving by having unwanted materials and debris hauled away.",
    href: "/services/construction-cleanup",
  },
  {
    icon: Truck,
    title: "Junk Removal",
    description: "From a few large items to a larger pile of unwanted stuff, we'll load it up and haul it away.",
    href: "/services/junk-removal",
  },
];

const furnitureItems = [
  "Couches & sofas",
  "Sectionals",
  "Recliners & chairs",
  "Tables & desks",
  "Dressers & cabinets",
  "Bed frames",
  "Mattresses & box springs",
  "Entertainment centers",
  "Patio furniture",
];

const largeItems = [
  "Refrigerators",
  "Freezers",
  "Washers & dryers",
  "Exercise equipment",
  "Other unwanted household items",
];

const debrisItems = [
  "Garage and basement contents",
  "Boxes and miscellaneous items",
  "Remodeling debris",
  "Yard debris",
  "Property debris",
  "General unwanted items",
];
---

<BaseLayout
  title="Junk Removal & Cleanout Services in Des Moines, IA | Clean Slate"
  description="Clean Slate provides junk removal, furniture removal, garage cleanouts, property cleanouts, estate cleanouts, and construction cleanup in Des Moines, IA."
>

  <Header />

  <main>

    <!-- ================= Hero ================= -->
    <section>
      <div class="container">

        <h1 class="mt-12 mb-6 max-w-3xl">
          Junk Removal &amp; Cleanout Services in Des Moines, IA
        </h1>

        <p class="mb-4! max-w-xl text-xl font-semibold text-heading">
          You don't need to haul it. We'll do the heavy lifting.
        </p>

        <p class="max-w-2xl text-lg text-body">
          From unwanted furniture and garage clutter to property
          cleanouts and renovation debris, Clean Slate makes it easier
          to clear unwanted items from your home or property.
        </p>

        <div class="mt-10 flex flex-wrap items-center gap-4">
          <Button href="/book-online" size="sm">Book Online</Button>

          <a
            href="tel:+15152023593"
            class="inline-flex items-center gap-2 font-medium text-primary transition hover:text-primary-dark"
          >
            Call or Text (515) 202-3593
          </a>
        </div>

      </div>
    </section>

    <!-- ================= Services ================= -->
    <section class="border-t border-border">
      <div class="container">

        <h2 class="mb-4 max-w-3xl">
          Junk Removal &amp; Cleanout Services in Des Moines
        </h2>

        <p class="max-w-2xl text-lg text-body">
          Clean Slate helps homeowners, landlords, contractors, and
          property owners throughout Des Moines clear unwanted items
          and debris.
        </p>

        <div class="mt-12 grid gap-10 sm:grid-cols-2 lg:grid-cols-3">
          {
            services.map((service) => (
              <a href={service.href} class="group flex flex-col">
                <service.icon
                  class="mb-4 text-primary"
                  size={32}
                  strokeWidth={1.5}
                />

                <h3 class="mb-2 text-xl! group-hover:text-primary!">
                  {service.title}
                </h3>

                <p class="mb-3 text-body">{service.description}</p>

                <span class="inline-flex items-center gap-2 font-semibold text-primary">
                  Learn More
                  <ArrowRight
                    class="transition group-hover:translate-x-1"
                    size={16}
                  />
                </span>
              </a>
            ))
          }
        </div>

      </div>
    </section>

    <!-- ================= No Truck. No Trailer. ================= -->
    <section class="border-t border-border py-16! text-center">
      <div class="container">

        <h2 class="mb-8">No Truck. No Trailer. No Dump Run.</h2>

        <p class="mx-auto max-w-2xl text-lg text-body">
          Getting rid of unwanted items shouldn't mean renting a
          vehicle, finding a trailer, or spending your day making dump
          runs.
        </p>

        <p class="mx-auto mt-6 max-w-2xl text-2xl font-semibold text-heading">
          Clean Slate handles the lifting, loading, hauling, and removal.
        </p>

      </div>
    </section>

    <!-- ================= What We Remove ================= -->
    <section class="bg-primary-dark">
      <div class="container">

        <h2 class="mb-12 text-white!">What We Remove</h2>

        <div class="grid gap-12 sm:grid-cols-2 lg:grid-cols-3">
          <div>
            <h3 class="mb-6 text-white!">Furniture</h3>
            <ul class="flex flex-col gap-4">
              {
                furnitureItems.map((item) => (
                  <li class="flex items-center gap-3">
                    <Check class="shrink-0 text-accent" size={20} />
                    <span class="font-medium text-white">{item}</span>
                  </li>
                ))
              }
            </ul>
          </div>

          <div>
            <h3 class="mb-6 text-white!">Large Household Items</h3>
            <ul class="flex flex-col gap-4">
              {
                largeItems.map((item) => (
                  <li class="flex items-center gap-3">
                    <Check class="shrink-0 text-accent" size={20} />
                    <span class="font-medium text-white">{item}</span>
                  </li>
                ))
              }
            </ul>
          </div>

          <div>
            <h3 class="mb-6 text-white!">Property &amp; Cleanup Debris</h3>
            <ul class="flex flex-col gap-4">
              {
                debrisItems.map((item) => (
                  <li class="flex items-center gap-3">
                    <Check class="shrink-0 text-accent" size={20} />
                    <span class="font-medium text-white">{item}</span>
                  </li>
                ))
              }
            </ul>
          </div>
        </div>

        <p class="mt-10 text-white/70">Not sure if we can take it? Just ask.</p>

      </div>
    </section>

    <!-- ================= Local ================= -->
    <section class="border-t border-border">
      <div class="container">

        <h2 class="mb-6 max-w-3xl">Serving Des Moines &amp; Surrounding Areas</h2>

        <p class="max-w-2xl text-lg text-body">
          Clean Slate provides full-service junk removal and cleanout
          services throughout Des Moines and the surrounding metro.
        </p>

        <p class="mt-6 max-w-2xl text-lg text-body">
          Whether you're clearing a single room, cleaning out a garage,
          preparing a property for sale, or dealing with renovation
          debris, we'll handle the heavy lifting.
        </p>

      </div>
    </section>

    <CTA
      title="Ready to Clear the Space?"
      description="Book online and let Clean Slate handle the lifting, loading, and hauling."
    />

  </main>

</BaseLayout>
