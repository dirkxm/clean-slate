---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/layout/Header.astro";
import Footer from "../../components/layout/Footer.astro";
import Button from "../../components/ui/Button.astro";
import CTA from "../../components/sections/CTA.astro";
import { Check, Sofa, Warehouse, Building2, Home, HardHat, Truck, ArrowRight } from "lucide-astro";

const services = [
  {
    icon: Warehouse,
    title: "Garage Cleanouts",
    description: "Clear out years of accumulated stuff and take your garage back.",
    href: "/services/garage-cleanouts",
  },
  {
    icon: Building2,
    title: "Property Cleanouts",
    description: "Full property cleanouts for homes, rentals, and more.",
    href: "/services/property-cleanouts",
  },
  {
    icon: Home,
    title: "Estate Cleanouts",
    description: "A respectful, straightforward way to clear a home.",
    href: "/services/estate-cleanouts",
  },
  {
    icon: HardHat,
    title: "Construction Cleanup",
    description: "Keep your remodeling or construction project moving.",
    href: "/services/construction-cleanup",
  },
  {
    icon: Sofa,
    title: "Furniture & Appliance Removal",
    description: "Couches, mattresses, and other bulky items hauled away.",
    href: "/services/furniture-removal",
  },
  {
    icon: Truck,
    title: "Junk Removal",
    description: "General junk and unwanted items removed quickly.",
    href: "/services/junk-removal",
  },
];

const furnitureItems = [
  "Couches & sofas",
  "Sectionals",
  "Recliners & chairs",
  "Tables & desks",
  "Dressers & cabinets",
  "Bed frames",
  "Mattresses & box springs",
  "Entertainment centers",
  "Patio furniture",
];

const largeItems = [
  "Refrigerators",
  "Freezers",
  "Washers & dryers",
  "Exercise equipment",
  "Other unwanted household items",
];

const debrisItems = [
  "Builder leftovers & packaging",
  "Move-in and downsizing clutter",
  "Garage, shed & outbuilding contents",
  "Acreage & yard debris",
  "Boxes and miscellaneous items",
  "General unwanted items",
];
---

<BaseLayout
  title="Junk Removal & Cleanout Services in Norwalk, IA | Clean Slate"
  description="Clean Slate provides junk removal, furniture removal, and cleanout services in Norwalk, IA. Book online and let us handle the heavy lifting."
>

  <Header />

  <main>

    <!-- ================= Hero ================= -->
    <section>
      <div class="container">

        <h1 class="mt-12 mb-6 max-w-3xl">
          Junk Removal &amp; Cleanout Services in Norwalk, IA
        </h1>

        <p class="mb-4! max-w-xl text-xl font-semibold text-heading">
          Get it out. We'll handle the heavy lifting.
        </p>

        <p class="max-w-2xl text-lg text-body">
          Clean Slate provides junk removal, furniture removal, and full
          property cleanouts for homes and businesses throughout
          Norwalk, IA.
        </p>

        <p class="mt-6 max-w-2xl text-lg text-body">
          Whether it's a single piece of furniture or an entire property
          that needs to be cleared, we handle the lifting, loading,
          hauling, and removal so you don't have to.
        </p>

        <div class="mt-10 flex flex-wrap items-center gap-4">
          <Button href="/online-ordering" size="sm">Get Your Price &amp; Book Online</Button>

          <a
            href="tel:+15155199878"
            class="inline-flex items-center gap-2 font-medium text-primary transition hover:text-primary-dark"
          >
            Text or Call (515) 519-9878
          </a>
        </div>

      </div>
    </section>

    <!-- ================= Services ================= -->
    <section class="border-t border-border">
      <div class="container">

        <h2 class="mb-4 max-w-3xl">
          Junk Removal &amp; Cleanout Services in Norwalk
        </h2>

        <p class="max-w-2xl text-lg text-body">
          Clean Slate provides full-service removal and cleanout services
          throughout Norwalk — from the newer subdivisions filling in
          south of the Des Moines airport to the larger acreage lots on
          the edges of town.
        </p>

        <div class="mt-12 grid gap-10 sm:grid-cols-2 lg:grid-cols-3">
          {
            services.map((service) => (
              <a href={service.href} class="group flex flex-col">
                <service.icon
                  class="mb-4 text-primary"
                  size={32}
                  strokeWidth={1.5}
                />

                <h3 class="mb-2 text-xl! group-hover:text-primary!">
                  {service.title}
                </h3>

                <p class="mb-3 text-body">{service.description}</p>

                <span class="inline-flex items-center gap-2 font-semibold text-primary">
                  Learn More
                  <ArrowRight
                    class="transition group-hover:translate-x-1"
                    size={16}
                  />
                </span>
              </a>
            ))
          }
        </div>

      </div>
    </section>

    <!-- ================= No Truck. No Trailer. ================= -->
    <section class="border-t border-border py-16! text-center">
      <div class="container">

        <h2 class="mb-8">No Truck. No Trailer. No Dump Run.</h2>

        <p class="mx-auto max-w-2xl text-lg text-body">
          You don't need to rent a truck or trailer, load everything
          yourself, or spend your weekend making dump runs.
        </p>

        <p class="mx-auto mt-6 max-w-2xl text-2xl font-semibold text-heading">
          Clean Slate handles the lifting, loading, hauling, and removal.
        </p>

      </div>
    </section>

    <!-- ================= What We Remove ================= -->
    <section class="bg-primary-dark">
      <div class="container">

        <h2 class="mb-12 text-white!">What We Remove</h2>

        <div class="grid gap-12 sm:grid-cols-2 lg:grid-cols-3">
          <div>
            <h3 class="mb-6 text-white!">Furniture</h3>
            <ul class="flex flex-col gap-4">
              {
                furnitureItems.map((item) => (
                  <li class="flex items-center gap-3">
                    <Check class="shrink-0 text-accent" size={20} />
                    <span class="font-medium text-white">{item}</span>
                  </li>
                ))
              }
            </ul>
          </div>

          <div>
            <h3 class="mb-6 text-white!">Large Household Items</h3>
            <ul class="flex flex-col gap-4">
              {
                largeItems.map((item) => (
                  <li class="flex items-center gap-3">
                    <Check class="shrink-0 text-accent" size={20} />
                    <span class="font-medium text-white">{item}</span>
                  </li>
                ))
              }
            </ul>
          </div>

          <div>
            <h3 class="mb-6 text-white!">New-Construction &amp; Outbuilding Debris</h3>
            <ul class="flex flex-col gap-4">
              {
                debrisItems.map((item) => (
                  <li class="flex items-center gap-3">
                    <Check class="shrink-0 text-accent" size={20} />
                    <span class="font-medium text-white">{item}</span>
                  </li>
                ))
              }
            </ul>
          </div>
        </div>

        <p class="mt-10 text-white/70">Not sure if we can take it? Just ask.</p>

      </div>
    </section>

    <!-- ================= Local ================= -->
    <section class="border-t border-border">
      <div class="container">

        <h2 class="mb-6 max-w-3xl">Serving Norwalk &amp; the Surrounding Area</h2>

        <p class="max-w-2xl text-lg text-body">
          Clean Slate serves homeowners, landlords, contractors, and
          property owners throughout Norwalk and the surrounding Des
          Moines metro, with dependable scheduling and straightforward,
          online booking.
        </p>

      </div>
    </section>

    <CTA
      title="Ready to Clear It Out?"
      description="Book your junk removal or cleanout online and choose a time that works for you."
    />

  </main>

  <Footer />

</BaseLayout>
