---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/layout/Header.astro";
import Footer from "../components/layout/Footer.astro";
import { services } from "../data/services";
import { ArrowRight, Clock, Hammer, Sofa, Truck } from "lucide-astro";

const portableStorage = services.find((item) => item.slug === "portable-storage");
if (!portableStorage) {
  throw new Error("Missing service data for slug: portable-storage");
}

interface OrderingLink {
  icon: typeof Truck;
  title: string;
  href: string;
  /** Short pill shown next to the title — for entries that aren't instant-priced. */
  badge?: string;
}

// Each category routes to its own Jobber "public request" intake form.
// Portable Storage has no form yet — it stays a "Coming Soon" entry.
const orderingLinks: OrderingLink[] = [
  {
    icon: Sofa,
    title: "Furniture & Appliance Removal",
    href: "https://clienthub.getjobber.com/hubs/936bcad6-c7f4-4cb8-b57a-16fabd6d5c1b/public/requests/5151715/new",
  },
  {
    icon: Truck,
    title: "Junk Removal & Cleanouts",
    href: "https://clienthub.getjobber.com/hubs/936bcad6-c7f4-4cb8-b57a-16fabd6d5c1b/public/requests/5152615/new",
  },
  {
    icon: Hammer,
    title: "Demolition & Construction Cleanup",
    // Demolition is scope-priced, not instant — routes to the same
    // Jobber request form, just flagged as needing a quote.
    href: "https://clienthub.getjobber.com/hubs/936bcad6-c7f4-4cb8-b57a-16fabd6d5c1b/public/requests/5227337/new",
    badge: "Quote Required",
  },
];
---

<BaseLayout
  title="Get Your Price | Clean Slate"
  description="Tell Clean Slate what you need — furniture and appliance removal, junk removal and cleanouts, or demolition — and request service online."
>

  <Header />

  <main>

    <!-- ================= Hero ================= -->
    <section class="py-8! sm:py-10!">
      <div class="container text-center">
        <h1 class="mb-3">Get Your Price</h1>
        <p class="mx-auto max-w-2xl text-lg text-body">
          Book online for instant pricing on junk removal &amp; cleanouts
          and furniture &amp; appliance removal. Demolition &amp;
          Construction Cleanup requires a quote.
        </p>
        <p class="mx-auto mt-4 max-w-2xl text-lg text-body">
          Prices shown are based on the details you provide. Once we're
          on site, if the job is smaller than described we'll refund the
          difference — if it's larger, we'll confirm with you before
          doing any additional work.
        </p>
        <p class="mx-auto mt-4 max-w-2xl text-lg text-body">
          Have something that doesn't fit these categories, or a larger
          project? We're happy to help.
        </p>
      </div>
    </section>

    <!-- ================= Ordering App ================= -->
    <section id="ordering-app" class="border-t border-border">
      <div class="container">

        <h2 class="mb-10 text-center text-3xl!">
          What do you need help with?
        </h2>

        <ul class="mx-auto flex max-w-2xl flex-col gap-4">
          {
            orderingLinks.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="group flex items-center gap-4 rounded-3xl border border-border bg-white p-6 shadow-soft transition hover:border-primary"
                >
                  <link.icon class="text-primary" size={32} strokeWidth={1.5} />
                  <span class="flex flex-1 flex-wrap items-center gap-3">
                    <span class="text-lg font-semibold text-heading">
                      {link.title}
                    </span>
                    {link.badge && (
                      <span class="inline-flex items-center whitespace-nowrap rounded-full bg-background px-3 py-1 text-xs font-semibold uppercase tracking-wide text-muted">
                        {link.badge}
                      </span>
                    )}
                  </span>
                  <ArrowRight
                    class="text-primary transition group-hover:translate-x-1"
                    size={20}
                  />
                </a>
              </li>
            ))
          }

          <li>
            <div class="flex items-center gap-4 rounded-3xl border border-border bg-white p-6 shadow-soft">
              <portableStorage.icon
                class="text-muted"
                size={32}
                strokeWidth={1.5}
              />
              <div class="flex-1">
                <div class="flex flex-wrap items-center gap-3">
                  <span class="text-lg font-semibold text-heading">
                    Portable Storage
                  </span>
                  <span class="inline-flex items-center gap-1.5 whitespace-nowrap rounded-full bg-background px-3 py-1 text-xs font-semibold uppercase tracking-wide text-muted">
                    <Clock size={12} />
                    Coming Soon
                  </span>
                </div>
                <p class="mt-2 text-body">{portableStorage.short}</p>
              </div>
            </div>
          </li>
        </ul>

        <div class="mx-auto mt-10 grid max-w-2xl gap-4 sm:grid-cols-2">
          <div class="rounded-3xl border border-border bg-white p-6 text-center shadow-soft">
            <p class="text-body">
              Not sure which category fits your job? Give us a call at
              (515) 519-9878 or <a
                href="/contact"
                class="font-semibold text-primary hover:text-primary-dark"
              >contact us</a> and we'll help you figure out the right fit.
            </p>
          </div>

          <div class="rounded-3xl border border-border bg-white p-6 text-center shadow-soft">
            <p class="text-body">
              Have something that doesn't fit these categories, or a
              larger project? <a
                href="/free-quote"
                class="font-semibold text-primary hover:text-primary-dark"
              >Request a free quote</a> instead.
            </p>
          </div>
        </div>

      </div>
    </section>

  </main>

  <Footer />

</BaseLayout>
