---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/layout/Header.astro";
import Hero from "../components/sections/Hero.astro";
import Services from "../components/sections/Services.astro";
import WhyUs from "../components/sections/WhyUs.astro";
import Gallery from "../components/sections/Gallery.astro";
import FAQ from "../components/sections/FAQ.astro";
import CTA from "../components/sections/CTA.astro";
---

<BaseLayout>

  <Header />

  <main>

    <Hero
      eyebrow="Professional Cleanup That Keeps Your Project Moving"
      title="When the<br class='hidden lg:inline' /> work is done,<br class='hidden lg:inline' /> we clean up."
      description="Professional construction cleanup for contractors, homeowners, and property managers across Central Iowa. Fast scheduling, dependable crews, and job sites left ready for the next phase."
    />

    <Services />

    <WhyUs />

    <Gallery />

    <FAQ />

    <CTA />

  </main>

</BaseLayout>