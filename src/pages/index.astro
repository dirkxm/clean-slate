---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/layout/Header.astro";
import Footer from "../components/layout/Footer.astro";
import Hero from "../components/sections/Hero.astro";
import Services from "../components/sections/Services.astro";
import WhyUs from "../components/sections/WhyUs.astro";
import CTA from "../components/sections/CTA.astro";
---

<BaseLayout
  title="Junk Removal & Cleanouts in the Des Moines Metro | Clean Slate"
  description="Junk removal, furniture removal, and full-service cleanouts across the Des Moines metro. Get your price and book online in minutes, or call for a free quote."
  ogDescription="Junk Removal & Cleanouts in the Des Moines Metro | Clean Slate"
>

  <Header />

  <main>

    <Hero
      title="Experience You Can Trust. Service Made Easy."
      description="Quality junk removal from an experienced local team, with the convenience of getting your price and booking online in just a few minutes."
      buttonLabel="Get Your Price & Book Online"
      showViewPricing={false}
      helpText="Have a question? You'll talk to a real person. We respond quickly and are here to help."
    />

    <Services />

    <WhyUs />

    <CTA
      title="Real People. Fast Replies."
      description="Online booking makes things easy, but you can always reach a real person when you need us. Questions about your job? Need help booking? Just give us a call or send us a message. We'll get back to you quickly."
      buttonLabel="Get Your Price & Book Online"
      secondaryLabel="Contact Us"
      secondaryHref="/contact"
    />

  </main>

  <Footer />

</BaseLayout>