---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/layout/Header.astro";
import Footer from "../components/layout/Footer.astro";
---

<BaseLayout
  title="Free Quote | Clean Slate"
  description="Request a free quote from Clean Slate for junk removal, temporary storage, or cleanout services in the Des Moines metro."
>

  <Header />

  <main>

    <section>
      <div class="container max-w-3xl">

        <h1 class="mt-12 mb-6">Request a Free Quote</h1>

        <p class="text-lg text-body">
          This form is for jobs that don't fit our instant online pricing &mdash;
          large or unusual projects, Portable Storage, or anything you're not
          sure how to categorize. Tell us what's going on and we'll follow up
          with a quote.
        </p>

        <p class="mt-4 text-lg text-body">
          Already know what you need?{" "}
          <a
            href="/online-ordering"
            class="font-semibold text-primary hover:text-primary-dark"
          >
            Get your price and book online
          </a>.
        </p>

        <!-- Jobber embedded "Request a Quote" work request form (form_id 5151784). -->
        <div id="936bcad6-c7f4-4cb8-b57a-16fabd6d5c1b-5151784" class="mt-10"></div>
        <link
          rel="stylesheet"
          href="https://d3ey4dbjkt2f6s.cloudfront.net/assets/external/work_request_embed.css"
          media="screen"
        />
        <script
          is:inline
          src="https://d3ey4dbjkt2f6s.cloudfront.net/assets/static_link/work_request_embed_snippet.js"
          clienthub_id="936bcad6-c7f4-4cb8-b57a-16fabd6d5c1b-5151784"
          form_url="https://clienthub.getjobber.com/client_hubs/936bcad6-c7f4-4cb8-b57a-16fabd6d5c1b/public/work_request/embedded_work_request_form?form_id=5151784"
        ></script>

        <noscript>
          <div class="mt-10 rounded-3xl border border-border bg-surface p-8 text-center">
            <p class="text-body">
              The quote form needs JavaScript to load. Call or text us at{" "}
              <a
                href="tel:+15152023593"
                class="font-semibold text-primary hover:text-primary-dark"
              >
                (515) 202-3593
              </a>{" "}
              or{" "}
              <a
                href="/contact"
                class="font-semibold text-primary hover:text-primary-dark"
              >
                send us a message
              </a>{" "}
              and we'll get you a quote right away.
            </p>
          </div>
        </noscript>

      </div>
    </section>

  </main>

  <Footer />

</BaseLayout>
