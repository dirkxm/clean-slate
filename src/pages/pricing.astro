---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/layout/Header.astro";
import Footer from "../components/layout/Footer.astro";
import Button from "../components/ui/Button.astro";
import CTA from "../components/sections/CTA.astro";
import { site } from "../config/site";
import { Sofa, Truck, Hammer, Package } from "lucide-astro";

// While "/pricing/" is in site.draftPages this page is noindex + kept
// out of the sitemap. Remove it from that array to take pricing live.
const isDraft = site.draftPages.includes("/pricing/");

const pricedCategories = [
  {
    icon: Sofa,
    title: "Furniture & Appliance Removal",
    price: "Starting at $65",
    description:
      "Single items typically range $50–$130 depending on size — from a couch or mattress up to a large refrigerator. Multiple items are priced together.",
  },
  {
    icon: Truck,
    title: "Junk Removal & Cleanouts",
    price: "Starting at $100",
    description:
      "A small load or single-room cleanout starts around $100. Larger cleanouts — garage, estate, full property — scale with size and volume, typically ranging up to $550 for a large full-property job.",
  },
  {
    icon: Hammer,
    title: "Demolition & Construction Cleanup",
    price: "$150–$500",
    description:
      "Priced by scope — from a single-room tear-out to a full renovation's worth of debris.",
  },
];
---

<BaseLayout
  title="Junk Removal & Cleanout Pricing in Des Moines | Clean Slate"
  description="See how Clean Slate pricing works for junk removal, furniture removal, and cleanout services throughout the Des Moines metro. Book online."
>

  {isDraft && (
    <meta slot="head" name="robots" content="noindex,nofollow" />
  )}

  <Header />

  <main>

    <!-- ================= Hero ================= -->
    <section>
      <div class="container">

        <h1 class="mt-12 mb-6 max-w-3xl">Simple, Straightforward Pricing</h1>

        <p class="mb-4! max-w-xl text-xl font-semibold text-heading">
          See your options, get your price, and book online.
        </p>

        <p class="max-w-2xl text-lg text-body">
          Clean Slate pricing depends on the service, size of the
          project, materials, and location. For services available
          online, you'll see current pricing during the booking process.
        </p>

      </div>
    </section>

    <!-- ================= Pricing by Service ================= -->
    <section class="bg-primary-dark">
      <div class="container">

        <ul class="max-w-2xl divide-y divide-white/15">
          {
            pricedCategories.map((category) => (
              <li class="flex gap-4 py-6 first:pt-0">
                <category.icon
                  class="mt-1 shrink-0 text-accent"
                  size={24}
                  strokeWidth={1.5}
                />

                <div>
                  <div class="flex flex-wrap items-baseline gap-x-3">
                    <h3 class="text-xl! text-white!">{category.title}</h3>
                    <span class="text-lg font-semibold text-accent">
                      {category.price}
                    </span>
                  </div>

                  <p class="mt-1 text-white/70">{category.description}</p>
                </div>
              </li>
            ))
          }
        </ul>

        <div class="mt-10">
          <Button href="/online-ordering" variant="secondary">
            Get Your Price
          </Button>
        </div>

        <!-- Portable Storage sits after the button — no online pricing yet. -->
        <div class="mt-12 max-w-2xl border-t border-white/15 pt-8">
          <div class="flex gap-4">
            <Package
              class="mt-1 shrink-0 text-white/40"
              size={24}
              strokeWidth={1.5}
            />

            <div>
              <div class="flex flex-wrap items-baseline gap-x-3">
                <h3 class="text-xl! text-white!">Portable Storage</h3>
                <span class="text-lg font-semibold text-white/50">
                  Coming Soon
                </span>
              </div>

              <p class="mt-1 text-white/70">
                Pricing will be available soon.{" "}
                <a
                  href="/contact"
                  class="font-semibold text-accent hover:underline"
                >
                  Contact us
                </a>{" "}
                for early availability.
              </p>
            </div>
          </div>
        </div>

      </div>
    </section>

    <!-- ================= Need Help ================= -->
    <section class="border-t border-border py-16! text-center">
      <div class="container">

        <h2 class="mb-6">Need Help?</h2>

        <p class="mx-auto max-w-2xl text-lg text-body">
          Call or text us. You'll talk to a real person.
        </p>

        <a
          href="tel:+15152023593"
          class="mt-6 inline-block text-2xl font-semibold text-primary hover:text-primary-dark"
        >
          (515) 202-3593
        </a>

      </div>
    </section>

    <CTA
      title="Ready to Get Started?"
      description="See your price and book online."
    />

  </main>

  <Footer />

</BaseLayout>
