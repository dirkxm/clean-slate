---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/layout/Header.astro";
import Footer from "../components/layout/Footer.astro";
import CTA from "../components/sections/CTA.astro";
import { User } from "lucide-astro";

// Team photos and bio copy to be added later. When photos are ready,
// import each and swap the placeholder avatar for an <Image />.
const team = [
  { name: "Melissa Dirkx", role: "Client Services Manager" },
  { name: "Travis Kersey", role: "Operations Manager" },
  { name: "Matt Dirkx", role: "Logistics Manager" },
];
---

<BaseLayout
  title="About Clean Slate | Des Moines Junk Removal & Cleanouts "
  description="Clean Slate has 10+ years of experience providing junk removal, furniture removal, and cleanout services throughout the Des Moines metro and Central Iowa."
>

  <Header />

  <main>

    <!-- ================= Hero ================= -->
    <section>
      <div class="container">

        <h1 class="mt-12 mb-6 max-w-3xl">About Clean Slate</h1>

        <p class="max-w-2xl text-lg text-body">
          With 10+ years of experience, we know how to get the job done
          efficiently, communicate clearly, and treat your property
          with care. Whether we're clearing out a garage, hauling away
          furniture, cleaning up after a renovation, or helping with a
          larger property cleanout, we handle the heavy lifting from
          start to finish.
        </p>

        <p class="mt-6 max-w-2xl text-lg text-body">
          We serve homeowners, contractors, landlords, and property
          owners throughout the Des Moines metro and Central Iowa.
        </p>

      </div>
    </section>

    <!-- ================= Simple. Reliable. Straightforward. ================= -->
    <section class="border-t border-border">
      <div class="container">

        <h2 class="mb-6 max-w-3xl">Simple. Reliable. Straightforward.</h2>

        <p class="max-w-2xl text-lg text-body">
          You can book online 24/7, or text or call and talk to a real
          person. No complicated process. No wondering when someone
          will get back to you.
        </p>


      </div>
    </section>

    <!-- ================= Meet the Team ================= -->
    <section class="border-t border-border">
      <div class="container">

        <h2 class="mb-12 max-w-3xl">Meet the Team</h2>

        <div class="grid gap-10 sm:grid-cols-2 lg:grid-cols-3">
          {
            team.map((member) => (
              <div class="flex flex-col items-start">
                {/* Placeholder avatar — replace with <Image /> once photos are available. */}
                <div class="mb-4 flex h-32 w-32 items-center justify-center rounded-full bg-primary/10">
                  <User class="text-primary/40" size={48} strokeWidth={1.5} />
                </div>

                <h3 class="mb-1">{member.name}</h3>
                <p class="text-body">{member.role}</p>
              </div>
            ))
          }
        </div>

      </div>
    </section>

    <CTA
      title="Ready to Clear the Space?"
      description="Book online and let Clean Slate take care of the heavy lifting."
    />

  </main>

  <Footer />

</BaseLayout>
