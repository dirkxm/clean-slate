---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/layout/Header.astro";
import Footer from "../components/layout/Footer.astro";
import Hero from "../components/sections/Hero.astro";
import ServicesGrid from "../components/sections/ServicesGrid.astro";
import ServiceArea from "../components/sections/ServiceArea.astro";
import FAQ from "../components/sections/FAQ.astro";
import CTA from "../components/sections/CTA.astro";

const faqs = [
  {
    question: "Can I get a price and book online?",
    answer:
      "Yes. Tell us what you need, provide the job details, choose a time, and we'll calculate your price before you book.",
  },
  {
    question: "How accurate is the online price?",
    answer:
      "We use the details you provide to calculate your price. We work hard to make the online price accurate. If the job is smaller than described, we'll refund the difference. If it's larger, we'll talk with you before adjusting the price.",
  },
  {
    question: "Can I talk to someone if I have a question?",
    answer:
      "Absolutely. Call or text us and you'll reach a real person. We respond as quickly as we can and can help you determine the best option for your project.",
  },
  {
    question: "What types of junk do you remove?",
    answer:
      "We remove furniture, appliances, household items, yard debris, construction debris, and many other unwanted items. If you're unsure, contact us.",
  },
  {
    question: "Do you handle small demolition?",
    answer:
      "Yes. We handle smaller demolition and tear-out projects that don't require heavy equipment.",
  },
  {
    question: "Do you clean up vacant properties?",
    answer:
      "Yes. We provide property cleanouts and basic vacant-property maintenance, including mowing, overgrowth removal, volunteer trees, brush, and yard debris.",
  },
  {
    question: "Do you work with contractors and property professionals?",
    answer:
      "Yes. We work with homeowners, contractors, property managers, investors, and others who need reliable cleanup and removal services.",
  },
];
---

<BaseLayout
  title="Services — Clean Slate"
  description="Construction cleanup, junk removal, portable storage, and property cleanouts throughout Central Iowa."
>

  <Header />

  <main>

    <Hero
      eyebrow="Junk Removal, Cleanup & Portable Storage"
      title="Whatever needs to go, we'll get it out of the way."
      description="From unwanted items and complete cleanouts to property cleanup and small demolition, Clean Slate makes it easy to get the job done."
      showTrustBadges={false}
      showImage={false}
    />

    <ServicesGrid />

    <!-- ================= Know Your Price ================= -->
    <section class="border-t border-border">
      <div class="container">

        <h2 class="mb-6 max-w-3xl">Know Your Price Before You Book</h2>

        <p class="max-w-2xl text-lg text-body">
          Tell us exactly what you need removed, choose a time that
          works for you, and get your price online. Our booking system
          uses the details you provide to calculate an accurate price
          before you schedule.
        </p>

        <p class="mt-6 max-w-2xl text-lg text-body">
          We work hard to make the price you see the price you pay. If
          the job is smaller than described, we'll refund the
          difference. If we find that the job is larger than described,
          we'll talk with you before making any adjustment.
        </p>

        <p class="mt-6 max-w-2xl text-xl font-semibold text-heading">
          Clear pricing. Easy booking. No surprises.
        </p>

      </div>
    </section>

    <!-- ================= Real People ================= -->
    <section class="bg-primary-dark">
      <div class="container text-center">

        <h2 class="mb-4 text-4xl! text-white!">
          Online When You Want It. Real People When You Need Us.
        </h2>

        <p class="mx-auto max-w-2xl text-xl text-white/70">
          Book online whenever it's convenient. Have a question? Call or
          text us and you'll talk with a real person. We respond
          quickly and are happy to help you figure out the right
          service for your job.
        </p>

      </div>
    </section>

    <ServiceArea />

    <FAQ
      title="Frequently Asked Questions"
      faqs={faqs}
      closingNote="Have a question we didn't answer? Call or text us."
    />

    <CTA
      title="Ready to Get It Done?"
      description="Tell us what you need, get your price, and choose a time that works for you."
      buttonLabel="Get Your Price & Book Online"
    />

  </main>

  <Footer />

</BaseLayout>
