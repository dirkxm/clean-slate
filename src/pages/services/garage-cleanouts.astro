---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/layout/Header.astro";
import Footer from "../../components/layout/Footer.astro";
import Button from "../../components/ui/Button.astro";
import CTA from "../../components/sections/CTA.astro";
import { Image } from "astro:assets";
import { Boxes, Truck, Sofa, Wrench, Hammer, Building2 } from "lucide-astro";
import heroImage from "../../assets/images/garage-cleanout.jpg";

const whatWeCleanOut = [
  {
    icon: Boxes,
    title: "Cluttered Garages",
    description:
      "Boxes, household items, old belongings, and years of accumulated stuff.",
  },
  {
    icon: Truck,
    title: "Moving & Downsizing",
    description: "Clear out the garage before a move, downsizing, or home sale.",
  },
  {
    icon: Sofa,
    title: "Old Furniture & Appliances",
    description:
      "Remove unwanted furniture, refrigerators, washers, dryers, and other large items.",
  },
  {
    icon: Wrench,
    title: "Tools & Equipment",
    description:
      "Get rid of unwanted tools, shelving, lawn equipment, and miscellaneous garage items.",
  },
  {
    icon: Hammer,
    title: "Garage Renovations",
    description:
      "Clear out the space before remodeling, finishing, or converting the garage.",
  },
  {
    icon: Building2,
    title: "Rental & Investment Properties",
    description:
      "Clean out garages between tenants or before putting a property on the market.",
  },
];

const relatedServices = [
  { label: "Estate Cleanouts", href: "/services/estate-cleanouts" },
  { label: "Property Cleanouts", href: "/services/property-cleanouts" },
  { label: "Furniture Removal", href: "/services/furniture-removal" },
  { label: "Construction Cleanup", href: "/services/construction-cleanup" },
  { label: "Service Areas", href: "/locations" },
];
---

<BaseLayout
  title="Garage Cleanouts in Des Moines, IA | Clean Slate"
  description="Professional garage cleanout services in Des Moines and surrounding areas. Clean Slate removes furniture, tools, boxes, appliances and more."
>

  <Header />

  <main>

    <!-- ================= Hero ================= -->
    <section>
      <div class="container">
        <a
          href="/services"
          class="mb-6 inline-block text-sm font-semibold text-primary hover:text-primary-dark"
        >
          ← Back to Services
        </a>
      </div>

      <div class="container grid gap-16 lg:grid-cols-[1fr_2fr] lg:items-start">

        <div>

          <h1 class="mb-6">
            Garage Cleanouts in Des Moines &amp; Surrounding Areas
          </h1>

          <p class="mb-4! max-w-xl text-xl font-semibold text-heading">
            Take your garage back.
          </p>

          <p class="max-w-xl text-body">
            Garages have a way of becoming the place everything gets
            stored. Clean Slate removes the furniture, boxes, tools,
            appliances, debris, and accumulated stuff taking up your
            space.
          </p>

          <div class="mt-10 flex flex-wrap items-center gap-4">
            <Button href="/online-ordering" size="sm">Book Online</Button>

            <a
              href="tel:+15152023593"
              class="inline-flex items-center gap-2 font-medium text-primary transition hover:text-primary-dark"
            >
              Call or Text (515) 202-3593
            </a>
          </div>

          <p class="mt-8 text-sm text-muted">
            Serving Norwalk, West Des Moines, Waukee, Ankeny, Des Moines
            and surrounding communities.
          </p>

        </div>

        <div class="rounded-3xl overflow-hidden">
          <Image
            src={heroImage}
            alt="Crew member removing items from a cluttered garage"
            class="w-full object-cover"
            widths={[480, 800, 1200, 1400]}
            sizes="(min-width: 1024px) 66vw, 100vw"
            format="webp"
            quality={80}
          />
        </div>

      </div>
    </section>

    <!-- ================= What We Clean Out ================= -->
    <section class="bg-primary-dark">
      <div class="container">

        <h2 class="mb-12 max-w-3xl text-white!">What We Clean Out</h2>

        <div class="grid gap-10 sm:grid-cols-2 lg:grid-cols-3">
          {
            whatWeCleanOut.map((item) => (
              <div class="flex flex-col">
                <item.icon
                  class="mb-4 text-accent"
                  size={32}
                  strokeWidth={1.5}
                />

                <h3 class="mb-2 text-white!">{item.title}</h3>

                <p class="text-white/70">{item.description}</p>
              </div>
            ))
          }
        </div>

      </div>
    </section>

    <!-- ================= No Heavy Lifting ================= -->
    <section>
      <div class="container">

        <h2 class="mb-6">
          Don't Need to Do the Heavy Lifting
        </h2>

        <p class="max-w-2xl text-lg text-body">
          You don't need to rent a dumpster, find a truck, or recruit
          family and friends to do the heavy lifting.
        </p>

        <p class="mt-6 max-w-2xl text-lg text-body">
          Clean Slate handles the loading, hauling, and removal from
          start to finish.
        </p>


      </div>
    </section>

    <!-- ================= Related Services ================= -->
    <section class="border-t border-border py-12!">
      <div class="container">
        <p class="mb-4 text-sm font-semibold uppercase tracking-[0.25em] text-muted">
          Related Services
        </p>

        <div class="flex flex-wrap gap-x-8 gap-y-3">
          {
            relatedServices.map((service) => (
              <a
                href={service.href}
                class="font-medium text-primary hover:text-primary-dark"
              >
                {service.label}
              </a>
            ))
          }
        </div>
      </div>
    </section>

    <CTA
      title="Ready to Take Your Garage Back?"
      description="Book your garage cleanout online and choose a time that works for you."
    />

  </main>

  <Footer />

</BaseLayout>
